# MemberPerkClub — environment variables
#
# Vercel: Project → Settings → Environment Variables → "Import .env" and upload
# this file, then edit each value. Apply to Production, Preview, and Development
# unless a comment below says otherwise.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle and are PUBLIC.
# Everything else is server-only and must never be prefixed with NEXT_PUBLIC_.
#
# Legend:  [REQUIRED] site breaks without it  ·  [PLACEHOLDER] fill in later
#          [OPTIONAL] has a sensible built-in default


# ─────────────────────────────────────────────────────────────
# Supabase — database + auth
# Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────

# [REQUIRED] Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# [REQUIRED] "anon / public" key. Safe in the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# [REQUIRED] "service_role" key. SERVER ONLY — bypasses every RLS policy.
# Used for admin member creation and producer enrollment. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY


# ─────────────────────────────────────────────────────────────
# Stripe — payments
# All four are PLACEHOLDERS for now. Until STRIPE_PRICE_ANNUAL is real,
# /join returns "checkout isn't configured yet" instead of crashing, and
# producer enrollment is disabled. Everything else on the site works.
# ─────────────────────────────────────────────────────────────

# [PLACEHOLDER] Developers → API keys → Secret key. Use sk_test_… until you go live.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# [PLACEHOLDER] Publishable key — safe in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# [PLACEHOLDER] Price ID (starts with price_, NOT the product id) for the
# $149/year recurring membership. Create it as a recurring yearly price.
STRIPE_PRICE_ANNUAL=price_REPLACE_ME

# [PLACEHOLDER] Signing secret for the webhook endpoint. Create the endpoint at
# https://memberperkclub.com/api/stripe/webhook AFTER the first deploy, subscribed to:
#   checkout.session.completed
#   customer.subscription.updated
#   customer.subscription.deleted
#   invoice.payment_failed
# Stripe shows the whsec_… secret once the endpoint exists.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Note: the $12 producer wholesale rate is NOT a Stripe Price — it's charged as a
# one-off PaymentIntent from PRODUCER_ENROLLMENT_FEE_CENTS in lib/stripe.ts.
# Change the amount in code, not here.


# ─────────────────────────────────────────────────────────────
# SMTP2GO — transactional email
# Set up SPF + DKIM for the sending domain in SMTP2GO BEFORE the first send,
# or welcome emails will land in spam.
# ─────────────────────────────────────────────────────────────

# [REQUIRED for email] SMTP2GO → Sending → API Keys
SMTP2GO_API_KEY=REPLACE_WITH_SMTP2GO_API_KEY

# [OPTIONAL] From: address on member-facing mail. Deliberately not hello@ —
# that address is already in use by another brand.
EMAIL_FROM=members@memberperkclub.com

# [OPTIONAL] Internal inbox for new-member and new-producer notifications.
# Back-end only; never rendered on any page.
ADMIN_NOTIFY_EMAIL=admin@memberperkclub.com


# ─────────────────────────────────────────────────────────────
# Site identity
# These drive the header, footer, page titles, metadata, legal pages, Stripe
# redirect URLs, and email links. Changing NEXT_PUBLIC_SITE_NAME here rebrands
# the entire site without a code change.
# ─────────────────────────────────────────────────────────────

# [REQUIRED in Production] No trailing slash. On Preview deployments, either
# leave this unset or set it to the preview URL — a wrong value sends Stripe
# redirects and email links to the wrong host.
NEXT_PUBLIC_SITE_URL=https://memberperkclub.com

# [OPTIONAL] Defaults below are already correct; override only to rebrand.
NEXT_PUBLIC_SITE_NAME=MemberPerkClub
NEXT_PUBLIC_SITE_DOMAIN=memberperkclub.com
NEXT_PUBLIC_SITE_LEGAL_ENTITY=MemberPerkClub, LLC
NEXT_PUBLIC_SUPPORT_EMAIL=support@memberperkclub.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@memberperkclub.com
