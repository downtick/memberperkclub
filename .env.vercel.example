# ─────────────────────────────────────────────────────────────────────────────
# MemberPerkClub — Vercel environment variables
#
# Vercel → Settings → Environment Variables → "Import .env" → upload this file,
# then edit each value. Apply to Production, Preview and Development unless a
# note below says otherwise. Redeploy afterwards — env changes do NOT apply to
# an existing build.
#
# After any deploy, GET https://memberperkclub.com/api/health to see which of
# these are actually set. It reports booleans only, never key material.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle and are PUBLIC.
# Everything else is server-only. Never put a secret in a NEXT_PUBLIC_ variable.
# ─────────────────────────────────────────────────────────────────────────────


# ── Supabase — database + auth ───────────────────────────────────────────────
# Dashboard → Project Settings → API.
# NOTE the naming: the "anon / publishable" key is the PUBLIC one and belongs in
# the NEXT_PUBLIC_ variable. The "service_role / secret" key bypasses every RLS
# policy and must stay server-only. Getting these backwards publishes full
# database access to every visitor.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_SECRET_KEY


# ── Stripe — payments ────────────────────────────────────────────────────────
# Create ONE product: "MemberPerkClub Membership", price $149.00 USD, recurring
# YEARLY. The $12 producer wholesale rate is NOT a Stripe Price — it is charged
# as a PaymentIntent from PRODUCER_ENROLLMENT_FEE_CENTS in lib/stripe.ts.
#
# STRIPE_PRICE_ANNUAL must be the id beginning with price_ — NOT prod_.
# Test-mode ids do not exist in live mode; swap all four together when switching.

STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_PRICE_ANNUAL=price_REPLACE_ME

# Add LAST. Stripe cannot create the endpoint until the URL exists, so deploy
# with the three values above first, then add the endpoint at
#   https://memberperkclub.com/api/stripe/webhook
# subscribed to: checkout.session.completed, customer.subscription.updated,
#                customer.subscription.deleted, invoice.payment_failed
# and paste its signing secret here, then redeploy again.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME


# ── SMTP2GO — transactional email ────────────────────────────────────────────
# From SMTP2GO → Sending → API Keys. This is the API key, which is different
# from the SMTP username/password Supabase needs for its own auth emails.
# Verify SPF + DKIM on the sending domain before the first send.

SMTP2GO_API_KEY=REPLACE_WITH_SMTP2GO_API_KEY
EMAIL_FROM=club@memberperkclub.com
ADMIN_NOTIFY_EMAIL=club@memberperkclub.com


# ── Site identity ────────────────────────────────────────────────────────────
# Drives the header, footer, titles, metadata, legal pages, Stripe redirect URLs
# and email links. Changing NEXT_PUBLIC_SITE_NAME rebrands the site with no code
# change.
#
# NEXT_PUBLIC_SITE_URL: on Preview deployments either leave unset or set it to
# the preview URL. If Preview inherits the production value, Stripe redirects and
# email links send people to the live site from a preview build.

NEXT_PUBLIC_SITE_URL=https://memberperkclub.com
NEXT_PUBLIC_SITE_NAME=MemberPerkClub
NEXT_PUBLIC_SITE_DOMAIN=memberperkclub.com
NEXT_PUBLIC_SUPPORT_EMAIL=club@memberperkclub.com
NEXT_PUBLIC_PRIVACY_EMAIL=club@memberperkclub.com

# ⚠ Set this to the legal entity that actually exists — it is printed in the
# Privacy Policy and Terms as the party responsible for the site.
NEXT_PUBLIC_SITE_LEGAL_ENTITY=MemberPerkClub, LLC
